# --- Auth (Google SSO, Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of allowed email domains. Anyone outside is rejected at sign-in.
ALLOWED_EMAIL_DOMAINS=chefrobotics.ai

# Comma-separated list of emails allowed to edit manual data. Everyone else is read-only.
EDITOR_EMAILS=

# --- Database (Neon Postgres) ---
# Get from Neon dashboard. Use the "pooled" connection string for serverless.
DATABASE_URL=

# --- Pylon ---
# Admin-created API token from Pylon dashboard (Bearer token).
PYLON_API_KEY=

# --- Datadog (optional for MVP; section renders "awaiting" until set) ---
DATADOG_API_KEY=
DATADOG_APP_KEY=
# Site: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu, etc.
DATADOG_SITE=datadoghq.com

# --- BigQuery (optional for MVP) ---
# Service-account JSON, single line, base64-encoded. Generate with:
#   cat sa.json | base64 | tr -d '\n'
GCP_SA_KEY_BASE64=
GCP_PROJECT_ID=
# Fully-qualified table or view, e.g. project.dataset.daily_metrics
BQ_METRICS_TABLE=

# --- Jira Cloud (Team tab — per-member bandwidth on a specific project) ---
# Base URL of your Atlassian site (no trailing slash).
JIRA_BASE_URL=https://chef.atlassian.net
# Account that owns the API token (usually your own Atlassian email).
JIRA_EMAIL=
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Short project key — appears as the prefix on issue IDs (e.g. CUST in CUST-123).
JIRA_PROJECT_KEY=CUST
